---
// Marketing landing page — standalone, not part of Starlight docs
import Site from '../layouts/Site.astro';
import QMark from '../components/QMark.astro';
import Mark from '../components/Mark.astro';
import '../styles/landing.css';
import data from '../data/compare.json';

const allFeatures = data.groups.flatMap(g => g.features);
const teaserFeatures = data.teaser.features.map(id => allFeatures.find(f => f.id === id)!);
const teaserProducts = data.teaser.products.map(id => data.products.find(p => p.id === id)!);
---
<Site title="Quern — Debug server for AI-assisted iOS & Android development"
      description="A local debug server that gives AI coding agents live access to your iOS simulators, Android emulators, and physical devices — logs, network traffic, screenshots, and UI control."
      page="home">

<section class="hero">
    <div class="container">
        <QMark size="168px" label="Quern" class="logo-mark" />
        <p class="eyebrow">Open source &middot; macOS &middot; Apache 2.0</p>
        <h1>Eyes, ears, and hands for AI&#8209;assisted mobile development and&nbsp;test.</h1>
        <p class="subtitle">A local debug server that gives AI coding agents live access to your iOS simulators, Android emulators, and physical devices &mdash; logs, network traffic, screenshots, and UI control. No cloud. No telemetry.</p>
        <div class="install-block">
            <code id="install-cmd">curl -fsSL https://quern.dev/install.sh | bash</code>
            <button class="copy-btn" onclick="copyInstall()" title="Copy to clipboard" id="copy-btn">&#x2398;</button>
        </div>
    </div>
</section>

<section class="container">
    <div class="features">
        <div class="card">
            <h3>Eyes</h3>
            <p>Screenshots, UI accessibility trees, screen summaries, and annotated overlays. Your agent sees exactly what's on screen.</p>
        </div>
        <div class="card">
            <h3>Ears</h3>
            <p>Real-time logs, crash reports, build output, and full network traffic capture. Every signal your app emits, captured.</p>
        </div>
        <div class="card">
            <h3>Hands</h3>
            <p>Tap, swipe, type, boot simulators and emulators, install apps, and intercept or mock HTTP traffic. Full control over the runtime.</p>
        </div>
    </div>
</section>

<section class="how-it-works container">
    <h2>How it works</h2>
    <div class="how-it-works-split">
        <div class="how-it-works-text">
            <p>Quern runs as a local server on your Mac. It connects to iOS simulators and Android emulators via their native toolchains, and to physical devices over USB. It captures logs and network traffic through lightweight adapters, and exposes everything as MCP tools that AI coding agents can call directly.</p>
            <p class="tool-count">107 MCP tools across 17 categories, lazy-loaded so they don't bloat your context window. Works with Claude Code, Cursor, and any MCP-compatible client.</p>
        </div>
        <div class="context-screenshot">
            <img src="images/context_use.png" alt="Context usage after loading 3 Quern MCP tools — only 4% of the context window used">
        </div>
    </div>
    <div class="infographic">
        <img src="images/infographic.png" alt="Quern architecture — giving AI agents eyes, ears, and hands for mobile debugging" width="1600">
    </div>
</section>

<section class="compare-teaser container">
    <h2>How Quern compares</h2>
    <p class="section-lede">Most tools in this space drive the device. Quern also debugs it: network, logs and app state, in the same place.</p>
    <div class="teaser-wrap">
        <table class="teaser">
            <thead><tr><th scope="col"><span class="sr-only">Capability</span></th><th scope="col" class="q">Quern</th>{teaserProducts.map(p => <th scope="col">{p.name}</th>)}</tr></thead>
            <tbody>
                {teaserFeatures.map(f => (
                    <tr>
                        <th scope="row">{f.label}</th>
                        <td class="q"><Mark state={(f.quern ?? ['y'])[0]} /></td>
                        {teaserProducts.map(p => { const [s, note] = p.v[f.id] ?? ['n']; return <td><Mark state={s} note={note} /></td>; })}
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
    <a class="cta" href="/compare/">See the full comparison, including where others lead &rarr;</a>
</section>

<section class="prompts container">
    <h2>What you can ask</h2>
    <div class="prompt-grid">
        <div class="prompt-card">Boot an iPhone 16 simulator, build my app, and show me any errors.</div>
        <div class="prompt-card">Boot a Pixel 9 emulator, install the APK, and check for crashes.</div>
        <div class="prompt-card">Mock the /api/users endpoint to return a 500 and see how the app handles it.</div>
        <div class="prompt-card">Find the last crash report and tell me what caused it.</div>
        <div class="prompt-card">Take a screenshot and tell me what's on screen.</div>
        <div class="prompt-card">Show me all the API calls made during login.</div>
        <div class="prompt-card">Intercept the auth token refresh and replace it with an expired one.</div>
        <div class="prompt-card">Boot three different devices and compare the layouts across platforms.</div>
        <div class="prompt-card">Open a live preview of my device so I can see what the agent is doing.</div>
        <div class="prompt-card">Check if the analytics payload includes the right event when I tap checkout.</div>
        <div class="prompt-card">Install the latest build on my physical device and walk through onboarding.</div>
        <div class="prompt-card">...and anything else you can think of.</div>
    </div>
</section>

<section class="requirements container">
    <h2>Requirements</h2>
    <ul class="req-list">
        <li class="required">macOS</li>
        <li class="required">Homebrew</li>
        <li class="required">Python 3.11+</li>
        <li class="required">Node.js 22+</li>
        <li class="platform">Xcode &mdash; iOS support enabled when detected</li>
        <li class="platform">Android SDK (adb) &mdash; Android support enabled when detected</li>
        <li class="auto">idb-companion &mdash; iOS simulator UI automation</li>
        <li class="auto">mitmproxy &mdash; network traffic capture</li>
        <li class="auto">pymobiledevice3 &mdash; iOS physical device support</li>
        <li class="auto">scrcpy &mdash; Android live screen preview</li>
    </ul>
    <p class="req-note">The install script detects your platforms and sets up everything automatically.</p>
</section>

<script is:inline>
function copyInstall() {
    navigator.clipboard.writeText('curl -fsSL https://quern.dev/install.sh | bash');
    var btn = document.getElementById('copy-btn');
    btn.textContent = '\u2713';
    setTimeout(function() { btn.innerHTML = '\u2398'; }, 1500);
}
</script>

</Site>
